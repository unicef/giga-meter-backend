DATABASE_URL="postgresql://test:test@localhost:5432/pcdc?schema=public"
USE_AUTH="true"
PROJECT_CONNECT_SERVICE_URL="https://uni-ooi-giga-maps-service-dev.azurewebsites.net"
DAILY_CHECK_APP_API_CODE="DAILY_CHECK_APP"
PCDC_APP_DOWNLOAD_URL="https://github.com/unicef/project-connect-daily-check-app/releases/download/v1.0.7/unicef-pdca-setup-1.0.7.exe"
SENTRY_DSN="https://your_sentry_dsn_here"
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NODE_ENV="ENVIRONMENT"
GIGA_METER_APP_KEY=12345
REDIS_URL=redis://localhost:6379
CACHE_EXPIRE=1800
GOOGLE_GEOLOCATION_API_KEY=your_google_geolocation_api_key_here
# Geolocate answers are cached in Redis by access point set. TTL is capped at
# 30 days (Google's limit for caching lat/lng); leave unset for the maximum.
# GEOLOCATION_CACHE_TTL_SECONDS=2592000
# Reuse a cached answer for a scan that shares most of its access points.
GEOLOCATION_CACHE_OVERLAP=false
DISTANCE_THRESHOLD=4000
ACCURACY_THRESHOLD=500
MLAB_API_KEY=
MLAB_TOKEN_EXCHANGE_URL=
MLAB_LOCATE_URL=
# Server-side PostHog events (src/analytics): measurements refused or flagged,
# devices registered and deactivated. Use the project key of the PostHog
# project the app builds report to. Unset = off.
POSTHOG_API_KEY=
# prod / stg / dev, sent as app_mode like the app's events: production and
# staging share one PostHog project and the dashboards filter on it. Worked out
# from SENTRY_ENVIRONMENT / NODE_ENV when unset; set it on production.
# POSTHOG_APP_MODE=prod
# POSTHOG_HOST=https://eu.i.posthog.com
